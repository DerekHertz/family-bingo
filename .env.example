# Copy to .env. Both are public values — the anon key authorizes nothing on its own,
# because RLS decides every row (ADR-0004). The service role key belongs in Vault on the
# server and must never appear here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Optional, and only for a project holding nobody's real data. Setting this puts a
# "Sign in without the email" row on the sign-in screen, which exchanges an address for a
# session against an Account that already exists — no email sent, no rate limit spent. It
# works only if the same value is also an Edge Function secret:
#
#   supabase secrets set DEV_LOGIN_SECRET=$(openssl rand -hex 32)
#
# Leave it unset and the row does not render and the function answers 404 to everyone.
# See supabase/functions/dev-login/index.ts for what it is and how to switch it off.
# EXPO_PUBLIC_DEV_LOGIN_SECRET=<the same 32+ character value>
