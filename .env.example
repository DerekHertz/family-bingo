# Copy to .env. Both are public values — the anon key authorizes nothing on its own,
# because RLS decides every row (ADR-0004). The service role key belongs in Vault on the
# server and must never appear here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
